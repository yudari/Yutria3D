# Yutria3D — salin ke `.env` lalu isi nilai asli. JANGAN commit `.env` berisi secret.
# cp .env.example .env   (Windows: copy .env.example .env)

# --- Autodesk Platform Services (wajib; isi dari dashboard APS user) ---
# Daftar app di https://aps.autodesk.com/ -> My Apps -> Create App.
APS_CLIENT_ID=
APS_CLIENT_SECRET=
# Nama bucket OSS (huruf kecil, unik global). Dibuat otomatis bila belum ada.
APS_BUCKET=yutria3d-bucket
# Batas ukuran upload file RVT (MB). Grill/grill: 500. File besar sebaiknya
# via direct-to-S3 signed URL (tahap lanjutan, belum tersedia).
MAX_UPLOAD_MB=500

# --- Web / API ---
# Origin frontend yang diizinkan CORS oleh backend.
WEB_ORIGIN=http://localhost:5173
# URL backend; DIBAKAR ke bundle frontend saat build (bukan runtime).
VITE_API_URL=http://localhost:5000

# --- Auth (wajib ganti di produksi; min 32 char) ---
JWT_KEY=changeme-min-32-chars-secret-key-here

# --- Database (Postgres; format ADO.NET Host=... — Npgsql menolak format URL) ---
# Render mengisi ini otomatis (format postgres://... dikonversi oleh
# Program.NormalizeDatabaseUrl). Lokal: arahkan ke Postgres sendiri.
DATABASE_URL=Host=127.0.0.1;Port=5432;Database=yutria3d;Username=postgres;Password=postgres

# ConnectionStrings:Default opsional; bila diisi, diprioritaskan atas DATABASE_URL.
# ConnectionStrings__Default=Host=127.0.0.1;Port=5432;Database=yutria3d;Username=postgres;Password=postgres

# --- Opsional (pengembangan lokal) ---
# Direktori file contoh .rvt (default: SampleFiles bawaan output build).
# SAMPLE_DIR=C:\data\sample-rvt

# Nilai Windows: localhost bisa resolve ke ::1 (IPv6) dan koneksi Npgsql/EF
# gagal dgn 10053 — pakai 127.0.0.1 eksplisit (lihat AGENTS.md bila ada).
